{
  "name": "thicket-sdk",
  "version": "0.4.0",
  "description": "Official TypeScript client for the Thicket API (thickethq.com): projects, to-dos, messages, docs, boards, calendar, chat, people, timesheets, search.",
  "keywords": [
    "thicket",
    "api",
    "sdk",
    "project-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thicket-hq/thicket-sdk.git"
  },
  "homepage": "https://github.com/thicket-hq/thicket-sdk#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/openapi.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run generate && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
